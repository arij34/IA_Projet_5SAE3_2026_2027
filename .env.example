# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne publiez JAMAIS .env sur GitHub.
SECRET_KEY=mettez-ici-une-cle-longue-et-aleatoire
DEBUG=True

# Configuration du LLM : "mock" (simulation, sans clé) ou "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=20