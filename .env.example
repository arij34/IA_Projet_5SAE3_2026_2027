# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne publiez JAMAIS .env sur GitHub.
SECRET_KEY=mettez-ici-une-cle-longue-et-aleatoire
DEBUG=True

# Configuration du LLM : "mock", "anthropic" ou "gemini"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20

# Client LLM de projects : "mock" pour le développement gratuit,
# "anthropic" ou "gemini" pour un vrai appel
PROJECT_LLM_PROVIDER=mock
CHATBOT_LLM_PROVIDER=mock
PROJECT_LLM_API_KEY=
PROJECT_LLM_MODEL=
# Génération de quiz Challenges : "mock" (défaut, gratuit) ou "openai". La clé reste côté serveur.
CHALLENGE_LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
CHALLENGE_GENERATION_THROTTLE_RATE=5/hour
# RAG local pour la génération de quiz (désactivé par défaut ; extraits de challenges/rag_data).
CHALLENGE_RAG_ENABLED=false
CHALLENGE_RAG_TOP_K=3
CHALLENGE_RAG_MAX_CHARS=3000
