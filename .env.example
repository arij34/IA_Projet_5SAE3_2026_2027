# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne publiez JAMAIS .env sur GitHub.
SECRET_KEY=mettez-ici-une-cle-longue-et-aleatoire
DEBUG=True

# Configuration du LLM : "mock", "anthropic" ou "gemini"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20

# Client LLM de projects : "mock" pour le développement gratuit,
# "anthropic" ou "gemini" pour un vrai appel
PROJECT_LLM_PROVIDER=mock
CHATBOT_LLM_PROVIDER=mock
PROJECT_LLM_API_KEY=
PROJECT_LLM_MODEL=